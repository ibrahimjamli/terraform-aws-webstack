#!/bin/bash
set -euo pipefail

# Minimal placeholder workload: enough to prove the load balancer, target group
# health check and auto scaling group all agree with each other. A real
# deployment would pull an application container here instead.

dnf install -y --quiet nginx

cat > /etc/nginx/conf.d/app.conf <<'NGINX'
server {
    listen ${app_port};
    server_name _;

    location /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        default_type text/plain;
        return 200 "served by $hostname\n";
    }
}
NGINX

# The default server block also listens on 80 and would shadow ours.
rm -f /etc/nginx/conf.d/default.conf
sed -i '/listen       80;/d;/listen       \[::\]:80;/d' /etc/nginx/nginx.conf || true

systemctl enable --now nginx
